rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerOrStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff'];
    }

    function ownsClientRecord() {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    function ownsProject(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwnerOrStaff());
      allow list: if isOwnerOrStaff();
      allow create, update, delete: if false;
    }

    match /customers/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid || isOwnerOrStaff();
      allow delete: if isOwnerOrStaff();
    }

    match /clientEnquiries/{enquiryId} {
      allow read: if isOwnerOrStaff() || ownsClientRecord();
      allow create: if false;
      allow update, delete: if isOwnerOrStaff();
    }

    match /services/{serviceId} {
      allow read: if isOwnerOrStaff() || resource.data.published == true;
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isOwnerOrStaff();
    }

    match /conversations/{conversationId} {
      allow read: if isOwnerOrStaff() || ownsClientRecord();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isOwnerOrStaff()
        || (ownsClientRecord()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'updatedAt', 'lastMessageAt', 'lastMessagePreview',
            'unreadForAdmin', 'unreadForCustomer', 'customerLastReadAt', 'status'
          ]));
      allow delete: if isOwnerOrStaff();

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read: if isOwnerOrStaff()
          || (signedIn() && parentConversation().customerId == request.auth.uid);
        allow create: if isOwnerOrStaff()
          || (signedIn()
            && parentConversation().customerId == request.auth.uid
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'customer');
        allow update, delete: if isOwnerOrStaff();
      }
    }

    match /notificationPreferences/{uid} {
      allow read, create, update, delete: if isOwnerOrStaff() || (signedIn() && request.auth.uid == uid);
    }

    match /notificationTokens/{uid} {
      allow read, create, update, delete: if isOwnerOrStaff() || (signedIn() && request.auth.uid == uid);
      match /tokens/{tokenId} {
        allow read, create, update, delete: if isOwnerOrStaff() || (signedIn() && request.auth.uid == uid);
      }
    }

    match /customerJourneyAnalytics/{summaryId} {
      allow read: if isOwnerOrStaff();
      allow write: if false;
    }

    match /customerJourneyEvents/{eventId} {
      allow read: if isOwnerOrStaff();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /projects/{projectId} {
      allow read: if isOwnerOrStaff() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /tasks/{taskId} {
      allow read: if isOwnerOrStaff() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /quotes/{quoteId} {
      allow read: if isOwnerOrStaff() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /invoices/{invoiceId} {
      allow read: if isOwnerOrStaff() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /payments/{paymentId} {
      allow read: if isOwnerOrStaff() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /assets/{assetId} {
      allow read: if isOwnerOrStaff()
        || resource.data.visibility == 'public'
        || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /documents/{documentId} {
      allow read: if isOwnerOrStaff()
        || resource.data.visibility == 'public'
        || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /calendarEvents/{eventId} {
      allow read: if isOwnerOrStaff() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /activityEvents/{eventId} {
      allow read: if isOwnerOrStaff() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isOwnerOrStaff();
    }

    match /enquiryPrivateNotes/{enquiryId} {
      allow read, create, update, delete: if isOwnerOrStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
